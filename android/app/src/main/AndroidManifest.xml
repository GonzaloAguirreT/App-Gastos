<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para pedirle el mes a la hoja. Es lo único que sale de aquí. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_nombre"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">

        <!-- Se abre al soltar el widget en el escritorio, para pegar la conexión.
             Es la única pantalla de esta app: lo demás es el widget. -->
        <activity
            android:name=".ConfigActivity"
            android:exported="true"
            android:label="@string/config_titulo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
            <!-- Y también desde el cajón de apps, para poder corregir el token
                 sin tener que borrar el widget y volver a ponerlo. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".WidgetGastos"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

    </application>
</manifest>
